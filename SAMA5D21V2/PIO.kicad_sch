	)
	(text_box "Check for NC\nThese are unused\n\nRXD (serial wakeup pin)\nDDR-D15-D31\nDDR_DQS2 DDR_DQS3\nDDR_DQM2 DDR_DQM3\nDDR_DQSN2 DDR_DQSN3\nPIOBU0-5\nCOMPP/COMPN\nCLK_AUDIO\nJTAGSEL"
		(exclude_from_sim no)
		(at 220.98 63.5 0)
		(size 40.64 25.4)
		(stroke
			(width 0)
			(type default)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "0a1c3653-d032-4c6d-a695-bd85b3a5d9c7")
	)
	(text_box "FLEXCOM2\n\nFlxPins	Pins	UART	SPI\nIO0		PA6		TXD		MOSI\nIO1		PA7		RXD		MISO\nIO2		PA8		SCK		SPCK\nIO3		PA9		CTS		NPCS0\n\nFLEXCOM3\n\nFlxPins	Pins	UART	FLEX_SPI	BOOT_SPI0\nIO0		PA15	TXD		MOSI		MOSI\nIO1		PA13	RXD		MISO		-\nIO2		PA14	SCK		SPCK		SPCK\nIO3		PA16	CTS		NPCS0		MISO\nIO4		PA17	DTR	xx	NPCS1		NPCS0\n\nConfusing: FLEX_SPI is Flexcom in SPI mode, but SPI0 is another peripheral MUXd with Flexcom\nThe boot code picks this SPI0 to boot from\nSlightly different pinout between the two SPIs as well"
