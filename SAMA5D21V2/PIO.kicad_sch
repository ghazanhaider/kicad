	(text_box "PIO		IOSET\n\nNAND	1\nLCD		1\nJTAG	1\nUART4	1\n\nFLEXCOM2	1\nFLEXCOM3	1\nPCK0	1\n"
		(exclude_from_sim no)
		(at 220.98 30.48 0)
		(size 40.64 25.4)
		(stroke
			(width 0)
			(type default)
