	(text_box "JTAG 20pin pinout		SWD+VCOM\n\nVTREF	1	2	NC		VTREF\nnTRST	3	4	GND		NC\nTDI		5	6	GND		(5-TX)\nTMS		7	8	GND		(7-SWDIO)\nTCK		9	10	GND		(9-SWCLK)\nRTCK	11	12	GND		NC\nTDO		13	14	GND		(13-SWO)\nnRST	15	16	GND		nRST\nNC		17	18	GND		(17-RX)\n5V		19	20	GND		5V\n\n\nJTAG 10pin pinout\n\nVCC		1	2	SWDIO/TMS\nGND		3	4	SWDCLK/TCK\nGND		5	6	SWO/TDO\nKEY		7	8	NC/TDI(TX)\nGNDDetect	10	nRST\n\nSAMA5D2 has no RTCK, eval has it NC"
