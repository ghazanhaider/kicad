		(uuid "dca3babc-4b4c-40f5-a361-8def802be252")
	)
	(text_box "POWER\n\nVDDCORE/VDDBU/VDDPLL		1.0V\nVDDIOM					1.8V/3.3V\nVDDIOP					1.8V/3.3V\nVDDUSB					3.3V\nVDDANA					3.3V\n(We will need minimum of 3.3V+1.0V)\n\nWe only use two discrete DCDCs: 1.0V and 3.3V\nThe EN pin of 1.0V DCDC is delayed by a cap against 3.3V to create a slight delay\nThe two discrete chips allow up to 1A of power.. sufficient\n\nPOWER SEQUENCE: \nVDDIO before VDDCORE\n3.3/1.8V rail sets EN pin of 1.0V rail\n\nINDUCTORS\nNot adding any because none of the documents for 9G20 recommend it unlike the 9G25"
		(exclude_from_sim no)
		(at 482.6 22.86 0)
		(size 66.04 45.72)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "e7dbdff7-88e2-4fbd-830d-2b3e52628111")
	)
