	(text_box "From Datasheet:\n\"Hardware Reset: By default, hardware reset is disabled and must be enabled in the\nEXT_CSD register if used. Otherwise, it can be left un-connected.\"\n\nData Stribe pin set to NC. It is used for HS400 mode\n\nWe'll just do 4pins because thats the max supported with 3.3V IO\nWith DDR and 52MHz that's 108MB/s\n\nRef:\nhttps://www.mouser.ca/datasheet/2/1389/Kingston_05_02_2024_EMMC08G_WV28_01J22_v1_1-3451902.pdf"
		(exclude_from_sim no)
		(at 154.94 20.32 0)
		(size 119.38 93.98)
		(stroke
			(width 0)
			(type default)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "36800bf6-d583-4da6-a21d-48aef348c73e")
	)
