	(text_box "DDR\n\nT layout\nWill try for no terminators\n\nUsing 1.5V power instead of 1.35V for PMIC simplicity/availability\n\n\nFor 2 chips:\nShared one CS/CLkpair/CKE/ODT\nOne resistor terminator for clk pair close to each IC\nDRAM_D0-D31 used as per Sable SoloX board, D32onwards unused\nA0-A14 used, A15 is NC. Allowing 512MB per chip\n\n\nD1216ECMDXGJD-U:		2Gb . A0 to A13\nD2516ECMDXGJD-U:		4Gb . A0 to A14\nAS4C512M16D3LB-12BIN:	8Gb . A0 to A15\nD1216ECMDXGJD-U"
		(exclude_from_sim no)
		(at 444.5 30.48 0)
		(size 116.84 76.2)
		(margins 0.9525 0.9525 0.9525 0.9525)
