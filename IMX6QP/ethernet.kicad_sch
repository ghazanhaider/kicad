	(text "Used for PCM pins in Wifi/BT"
		(exclude_from_sim no)
		(at 32.766 157.734 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "f2cccebb-d3ce-46e5-a6e2-8665ede589b5")
	)
	(text_box "GIGABIT\n\n\nVSC8531XMW-02\nMagnetics and connector: ARJM11C7-502-AB-ER2-T (cheapest gigabit with mag and LEDs\n\nWe use 1.5v RGMII\nREFCLK_SEL[1:0] = 00 (GND) = 25MHz xtal used\n\nPOWER\nVDD1 1.0V (90mA)\nVDD1A 1.0V (25mA)       (1.0V Disabled both by solderjumper and PMIC default cfg)\nVDD25A 2.5V (150mA)     (2.5V Disabled by solderjumper)\nVDDIO 2.5V\nVDDMDIO 2.5V (5mA)\nVDDMAC 2.5V (Rs = 39 OHM)\n\n\nLEDs:\nThe PHY uses active low. We'll need to invert this in PHY's registers\n\ntotal:\n1.0V = 115mA (VGEN3)\n2.5V = 155mA \n= 0.5W\n"
		(exclude_from_sim no)
		(at 223.52 12.7 0)
		(size 60.96 71.12)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "23359397-716c-41ed-9237-68a38aafe3a9")
	)
	(text_box "CRYSTAL\n==============\n25MHz Crystal for eth. One of:\n\n300uW 50ppm load cap=20pF ESR<=30ohm pin cap=3pF\n100uW 50ppm load cap=8-12pF ESR<=80ohm pin cap=3pF, XTAL2 series=500ohm\nECS-250-8-36CKM-TR3 = 100uW, 8 pF, 10ppm, ESR max 60ohm\nFL2500213Z = 20pF, 20ppm, 30ESR ()3.2mmx2.5mm) <= use this\n\n\nCLOCK(RGMII)\n==============\nSOC clk input ENET_REF_CLK:\n- Either pin RGMII_TX_CTL(2.5)\n- Or pin GPIO_16(3.0/3.3V)\n- OR all internal from PLL6 <=========\n\nConnects to TX_CTL(pin23 of the phy)(2.5V)\n\nTODO\nAdd 49.9 ohm pullups\n"
		(exclude_from_sim no)
		(at 223.52 101.6 0)
		(size 60.96 50.8)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "7af09a05-36a8-42e1-818f-d91ef3777e66")
	)
	(text_box "ETHERNET\n\nPin configs\nREGOFF=0 (1.2V Regulator = ON)\nnINTSEL = 0 (REFCLKO outputs clk)\n"
		(exclude_from_sim no)
		(at 223.52 86.36 0)
		(size 60.96 12.7)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ce9bccb9-e943-4049-a30f-63cf3c27138b")
	)
