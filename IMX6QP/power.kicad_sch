	)
	(text_box "Main XTAL\nECS-240-8-36CKM-TR xx\n24MHz 8pF load capacitance\n100uW drive\nESR:60mOHM\nCaps: 6pF - 12pF\n\nXRCGB24M000FBP12R0 <==\n24MHz 6pF\n2.0 x 1.6mm\n300uW max\nESR: 80Ohm\n\nRTC:\nECS-.327-12.5-34B-TR\n12.5pF load capacitance\nCaps: 15pF - 21pF"
		(exclude_from_sim no)
		(at 381 210.82 0)
