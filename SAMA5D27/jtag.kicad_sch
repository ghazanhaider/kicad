	(text_box "JTAG uses JTAG IOSET1\nThis affects Flexcom4 and\nother minor pins"
		(exclude_from_sim no)
		(at 185.42 33.02 0)
		(size 72.39 36.83)
		(stroke
			(width 0)
			(type default)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "0a0ae63e-9808-43ab-b852-963952c9f8dd")
	)
	(text_box "JTAG 20pin pinout		SWD+VCOM\n\nVTREF	1	2	NC		VTREF\nnTRST	3	4	GND		NC\nTDI		5	6	GND		(5-TX)\nTMS		7	8	GND		(7-SWDIO)\nTCK		9	10	GND		(9-SWCLK)\nRTCK	11	12	GND		NC\nTDO		13	14	GND		(13-SWO)\nnRST	15	16	GND		nRST\nNC		17	18	GND		(17-RX)\n5V		19	20	GND		5V\n\n\nJTAG 10pin pinout\n\nVCC		1	2	SWDIO/TMS\nGND		3	4	SWDCLK/TCK\nGND		5	6	SWO/TDO\nKEY		7	8	NC/TDI(TX)\nGNDDetect	10	nRST\n\nSAMA5D2 has no RTCK, eval has it NC"
		(exclude_from_sim no)
		(at 177.8 82.55 0)
		(size 66.04 62.23)
		(stroke
			(width 0)
			(type default)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "e64c63e7-e3b8-42d3-b686-bc99331f468a")
	)
