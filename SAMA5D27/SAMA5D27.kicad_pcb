	(gr_text_box "USB\nDiff: 90ohm, single: 45ohm\nTrack:5mil, Spac: 6mil\nLength matching: 150mil/3.81mm\n"
		(start 183.675 50.7)
		(end 215.925 66.8)
		(layer "F.Cu")
		(uuid "10c93c8b-3d8b-439f-94c1-45d247f64fdc")
		(effects
			(font
				(size 1.5 1.5)
				(thickness 0.3)
				(bold yes)
			)
			(justify left top)
		)
		(border yes)
		(stroke
			(width 0.2)
			(type solid)
		)
	)
	(gr_text_box "INTERFACES\n\n Int	 Details							 IOSET\nUART0	RX/TX/GND Header					1\nUART1	Double header into SWD				1\n (TX uses pin7)\nSPI0	Pins multiplexed with FLEXCOM3		1\nFLEXCOM2	Header							1\nFLEXCOM3	Read separate Textbox on this	1\nLCD		6-bit per color[2:7]				2"
		(start 201.5 85.95)
		(end 281.1 115.4)
		(layer "F.Cu")
		(uuid "37a26042-517d-44e5-abc6-f00360a3ff4d")
		(effects
			(font
				(size 1.5 1.5)
				(thickness 0.3)
				(bold yes)
			)
			(justify left top)
		)
		(border yes)
		(stroke
			(width 0.2)
			(type solid)
		)
	)
	(gr_text_box "LENGTHS\n\nWithin each lane, match data to within 20mil/0.508mm of data strobe diff pair\n\nBetween lanes, match to 1 inch\n\nDiff pairs match to 5mil\n\nAddress/Command/Ctrl match to clk: 10mil/0.254mm\n\nClk must be longed than strobe\n\nNAND: Same layer and 400mil/10mm match"
		(start 248.8 15)
		(end 281.2 67.8)
		(layer "F.Cu")
		(uuid "4bfe33cf-3c16-4388-9ed2-bf58b45cc00b")
		(effects
			(font
				(size 1.5 1.5)
				(thickness 0.3)
				(bold yes)
			)
			(justify left top)
		)
		(border yes)
		(stroke
			(width 0.2)
			(type solid)
		)
	)
	(gr_text_box "FLEXCOM2\n\nFlxPins	Pins	UART	SPI		I2C/TWI\nIO0		PA6		TXD		MOSI	TWD\nIO1		PA7		RXD		MISO	TWCK\nIO2		PA8		SCK		SPCK\nIO3		PA9		CTS		NPCS0\n\nFLEXCOM3\n\nFlxPins	Pins	UART	FLEX_SPI	BOOT_SPI0	I2C/TWI\nIO0		PA15	TXD		MOSI		MOSI		TWD\nIO1		PA13	RXD		MISO		-			TWCK\nIO2		PA14	SCK		SPCK		SPCK\nIO3		PA16	CTS		NPCS0		MISO\nIO4		PA17	DTR	xx	NPCS1		NPCS0\n\nConfusing: FLEX_SPI is Flexcom in SPI mode, but SPI0 is another peripheral MUXd with Flexcom\nThe boot code picks this SPI0 to boot from\nSlightly different pinout between the two SPIs as well"
		(start 167.95 115.4)
		(end 283.55 166.1)
		(layer "F.Cu")
		(uuid "4c744abb-0e61-405b-908a-8a30145c0aef")
		(effects
			(font
				(size 1.5 1.5)
				(thickness 0.3)
				(bold yes)
			)
			(justify left top)
		)
		(border yes)
		(stroke
			(width 0.2)
			(type solid)
		)
	)
	(gr_text_box "Trace Current\n\n LOAD		 MAX\nVDDCORE		40mA\nVDDPLLA		14.5mA\nVDDUTMIC		9mA\nTotal 1.25V	70mA\n\n3.3			500mA\n\nVDDIODDR		\n"
		(start 178.7 14.825)
		(end 218 46.375)
		(layer "F.Cu")
		(uuid "f687a162-a081-438f-af4f-d82d43444b9f")
		(effects
			(font
				(size 1.5 1.5)
				(thickness 0.3)
				(bold yes)
			)
			(justify left top)
		)
		(border yes)
		(stroke
			(width 0.2)
			(type solid)
		)
	)
	(gr_text_box "DDR3L ROUTING\n\nLane1:\nDDR_D[0:7]\nDDR_DQS0\nDDR_DQSN0\nDDR_DM0\n\nLane2:\nDDR_D[8:15]\nDDR_DQS1\nDDR_DQSN1\nDDR_DM1\n\nAddress:\nDDR_RAS/CAS\nA[0:23]\nDDR_BA[0:2]\nDDR_WE\n\nControl:\nDDR_CS\nDDR_CKE\nDDR_RESETN\n\nClock:\nDDR_CK\nDDR_CKN"
		(start 222.3 14.9)
		(end 245.9 84.75)
