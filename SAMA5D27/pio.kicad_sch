	(text_box "PIO		IOSET\n\nNAND	1\nLCD		2\nJTAG	1\nFLEXCOM2	1\nFLEXCOM3	1\nPCK0	1\n"
		(exclude_from_sim no)
		(at 215.9 43.18 0)
		(size 40.64 17.78)
		(stroke
			(width 0)
			(type default)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "068e54db-d207-4dca-82e1-d475e09af677")
	)
	(text_box "Check for NC\nThese are unused\n\nRXD (serial wakeup pin)\nDDR-D15-D31\nDDR_DQS2 DDR_DQS3\nDDR_DQM2 DDR_DQM3\nDDR_DQSN2 DDR_DQSN3\nHHSDPDATC HHSDMSTRC (HSIC)\nPIOBU0-7"
		(exclude_from_sim no)
		(at 215.9 76.2 0)
		(size 40.64 25.4)
		(stroke
			(width 0)
			(type default)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "0a1c3653-d032-4c6d-a695-bd85b3a5d9c7")
	)
	(text_box "FLEXCOM2\n\nFlxPins	Pins	UART	SPI\nIO0		PA6		TXD		MOSI\nIO1		PA7		RXD		MISO\nIO2		PA8		SCK		SPCK\nIO3		PA9		CTS		NPCS0\n\nFLEXCOM3\n\nFlxPins	Pins	UART	FLEX_SPI	BOOT_SPI0\nIO0		PA15	TXD		MOSI		MOSI\nIO1		PA13	RXD		MISO		-\nIO2		PA14	SCK		SPCK		SPCK\nIO3		PA16	CTS		NPCS0		MISO\nIO4		PA17	DTR	xx	NPCS1		NPCS0\n\nConfusing: FLEX_SPI is Flexcom in SPI mode, but SPI0 is another peripheral MUXd with Flexcom\nThe boot code picks this SPI0 to boot from\nSlightly different pinout between the two SPIs as well"
		(exclude_from_sim no)
		(at 215.9 111.76 0)
		(size 58.42 45.72)
		(stroke
			(width 0)
			(type default)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "4966a8a7-6066-4dd2-a1ea-4c56fa56ea07")
	)
