	(text_box "ETHERNET\n\nTwo SGMII ethernet (LANES 2 and 3 of SERDES1)\nTwo 10gbit XFI ethernet interfaces using SerDes1 are on the serdes page\n\n\nRTL8211FS (RGMII)\n- QFN48\n- RGMII voltages supported: 3.3 2.5 1.8 1.5\n- Internal volt: 1.0v\n- 25MHz xtal/osc input\n- 125MHz output to MAC\n\nRTL8221 ($3 LCSC)\n- 2.5G SGMII\n\nSFP+ cage ($2.5)\n- XGMII\n- Only 3.3v 2-3W supply needed\n- DAC cable can be used with SFP switches"
		(exclude_from_sim no)
		(at 210.82 20.32 0)
		(size 60.96 53.34)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "e192b5fe-f87f-4b44-870a-6ee83e8b7203")
	)
	(text_box "SFP+\n(U77-A1619-2001 as a basis)\n\n20pins:\n\n	\nRD+ / RD- (receive pair)\nTD+ / TD- (tmit pair)\nVccT / VccR (TX / RX power =3.3v)\nTX_Disable\n\n\nTX_Fault\nSDA SCL-\n\nMOD_ABS (module absent)\nRS0 (Rate select 0)\nRS1 (Rate select 1)\nRx_LOS (Receiver loss of signal indication)\n"
		(exclude_from_sim no)
		(at 210.82 78.74 0)
		(size 60.96 53.34)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "eb05d060-08ac-4aa6-bb75-373444db6f74")
	)
